import wollok.game.*
import panda.*
import panda_snack.*
import puntos.*
import comidas.*
import sistemaDirecciones.*
import sistemaDeFondo.*
import sistemaSonido.*
import selector.*
import niveles.*

///////////////////////
describe "Panda" {
  test "El panda empieza con 3 vidas" {
    assert.equals(3, panda.vida())
  }
  test "El panda empieza con 0 puntos" {
    assert.equals(0, panda.puntosSumados())
  }
  test "El panda empieza en la posicion (2,0)" {
    assert.equals(game.at(2,0), panda.position())
  }
  test "El panda empieza con 0 comidas desperdiciadas" {
    assert.equals(0, panda.comidasDesperdiciadas())
  }
  test "El panda empieza con su imagen normal" {
    assert.equals("panda_inicio.png", panda.image())
  }
  test "reiniciarPanda devuelve todo al estado inicial" {
    panda.perderVida()
    panda.puntosSumados(7)
    panda.position(game.at(4,0))
    panda.comidasDesperdiciadas(3)

    panda.reiniciarPanda()

    assert.equals(3, panda.vida())
    assert.equals(0, panda.puntosSumados())
    assert.equals(game.at(2,0), panda.position())
    assert.equals(0, panda.comidasDesperdiciadas())
    assert.equals("panda_inicio.png", panda.image())
  }

}
describe "Puntos" {
  const posicion = game.at(2,0)
  test "Suma puntos por Bambu" {
    const unBambu = new Bambu(position = posicion)
    unBambu.esComidaPor(panda)
    assert.equals(unBambu.puntos(), panda.puntosSumados())
  }
  test "Suma puntos por Dumpling" {
    const unDumpling = new Dumpling(position = posicion)
    unDumpling.esComidaPor(panda)
    assert.equals(unDumpling.puntos(), panda.puntosSumados())
  }
  test "Suma puntos por BubbleTee" {
    const unBubbleTee = new BubbleTee(position = posicion)
    unBubbleTee.esComidaPor(panda)
    assert.equals(unBubbleTee.puntos(), panda.puntosSumados())
  }
  test "Pierde puntos por Aji" {
    panda.puntosSumados(10)
    const unAji = new Aji(position = posicion)
    unAji.esComidaPor(panda)
    assert.equals(9, panda.puntosSumados())
  }
  test "Pierde puntos por Hongo, es primera comida y no cae en negativo" {
    const unHongo = new Hongo(position = posicion)
    unHongo.esComidaPor(panda)
    assert.equals(0, panda.puntosSumados())
    
  }
  test "No suma puntos por Bambu podrido" {
    panda.puntosSumados(10)
    const unBambuPodrido = new BambuPodrido(position = posicion)
    unBambuPodrido.esComidaPor(panda)
    assert.equals(10, panda.puntosSumados())
  }
}
describe "Comidas desperdiciadas" {
  const posicionPiso = game.at(1,0)
  test "Suma comidas desperdiciadas por Bambu" {
    const unBambu = new Bambu(position = posicionPiso)
    unBambu.caer()
    assert.equals(1, panda.comidasDesperdiciadas())
  }
  test "Suma comidas desperdiciadas por Dumpling" {
    const unDumpling = new Dumpling(position = posicionPiso)
    unDumpling.caer()
    assert.equals(1, panda.comidasDesperdiciadas())
  }
  test "Suma comidas desperdiciadas por BubbleTee" {
    const unBubbleTee = new BubbleTee(position = posicionPiso)
    unBubbleTee.caer()
    assert.equals(1, panda.comidasDesperdiciadas())
  }
  test "No suma comidas desperdiciadas por Aji" {
    const unAji = new Aji(position = posicionPiso)
    unAji.caer()
    assert.equals(0, panda.comidasDesperdiciadas())
  }
  test "No suma comidas desperdiciadas por Hongo" {
    new Hongo(position = posicionPiso).caer()
    assert.equals(0, panda.comidasDesperdiciadas())
  }
  test "No suma comidas desperdiciadas por Bambu podrido" {
    new BambuPodrido(position = posicionPiso).caer()
    assert.equals(0, panda.comidasDesperdiciadas())
  }
  test "Una comida buena que todavia no llego al piso baja una celda y no se desperdicia" {
    const unBambu = new Bambu(position = game.at(2,3))
    unBambu.caer()
    assert.equals(game.at(2,2), unBambu.position())
    assert.equals(0, panda.comidasDesperdiciadas())
  }
}
describe "Las comidas son buenas " {
  test "El bambu es bueno" {
    const bambu = new Bambu(position=0)
    assert.that(bambu.esBuena())
  }
  test "El dumpling es bueno" {
    const dumpling = new Dumpling(position=0)
    assert.that(dumpling.esBuena())
  }
  test "El bubble tee es bueno" {
    const bubbleTee = new BubbleTee(position=0)
    assert.that(bubbleTee.esBuena())
  }
  test "El aji no es bueno" {
    const aji = new Aji(position = 1)
    assert.notThat(aji.esBuena())
  }
  test "El hongo no es bueno" {
    const hongo = new Hongo(position = 1)
    assert.notThat(hongo.esBuena())
  }
  test "El bambu podrido no es bueno" {
    const bambuPodrido = new BambuPodrido(position = 1)
    assert.notThat(bambuPodrido.esBuena())
  }
}
describe "Vidas" {
  const posicionComida = game.at(2,0)
  test "Pierde vidas por Aji" {
    const unAji = new Aji(position = posicionComida)
    unAji.esComidaPor(panda)
    assert.equals(2, panda.vida())
  }
  test "Pierde vidas por Hongo" {
    const unHongo = new Hongo(position = posicionComida)
    unHongo.esComidaPor(panda)
    assert.equals(2, panda.vida())
  }
  test "No pierde vidas por Bambu podrido" {
    const unBambuPodrido = new BambuPodrido(position = posicionComida)
    unBambuPodrido.esComidaPor(panda)
    assert.equals(3, panda.vida())
  }
  test "No pierde vidas por Bambu" {
    const unBambu = new Bambu(position = posicionComida)
    unBambu.esComidaPor(panda)
    assert.equals(3, panda.vida())
  }

}
describe "Efectos" {
  const posicionComida = game.at(2,0)
  test "Mover erratico por Aji" {
    const unAji = new Aji(position = posicionComida)
    unAji.esComidaPor(panda)
    panda.mover(derecha)
    assert.equals(game.at(4,0), panda.position())
  }
  test "Mover opuesto por Hongo" {
    const unHongo = new Hongo (position = posicionComida)
    unHongo.esComidaPor(panda)
    panda.mover(derecha)
    assert.equals(game.at(1,0), panda.position())
  }
  test "No se mueve por Bambu podrido" {
    const unBambuPodrido = new BambuPodrido(position = posicionComida)
    unBambuPodrido.esComidaPor(panda)
    panda.mover(derecha)
    assert.equals(game.at(2,0), panda.position())
  }
  test "Panda vestido por Dumpling" {
    const unDumpling = new Dumpling(position = posicionComida)
    unDumpling.esComidaPor(panda)
    assert.equals("panda_con_ropa.png", panda.image())
  }
   test "Panda con gorrito cuando toma un BubbleTee" {
    const unBubbleTee= new BubbleTee(position = posicionComida)
    unBubbleTee.esComidaPor(panda)
    assert.equals("panda_helado.png", panda.image())
  }
  test "Vuelve a la normalidad cuando termina el efecto" {
    const unDumpling = new Dumpling(position = posicionComida)
    unDumpling.esComidaPor(panda)
    panda.volverALaNormalidad()
    assert.equals("panda_inicio.png", panda.image())
  }

}
describe "Los efectos no se superponen" {
  const posicionComida = game.at(2,0)
  test "Si el panda esta vestido y toma un BubbleTee, queda congelado" {
    const unDumpling = new Dumpling(position = posicionComida)
    unDumpling.esComidaPor(panda)
    const unBubbleTee = new BubbleTee(position = posicionComida)
    unBubbleTee.esComidaPor(panda)
    assert.equals("panda_helado.png", panda.image())
  }
  test "Si el panda esta congelado y toma un Dumpling, queda vestido" {
    const unBubbleTee = new BubbleTee(position = posicionComida)
    unBubbleTee.esComidaPor(panda)
    const unDumpling = new Dumpling(position = posicionComida)
    unDumpling.esComidaPor(panda)
    assert.equals("panda_con_ropa.png", panda.image())
  }
}
describe "Fondos de niveles"{
  const posicionComida = game.at(2,0)
  test "Empieza descongelado" {
    assert.notThat(fondoNiveles.congelado())
  }
  test "Un BubbleTee congela el fondo" {
    const unBubbleTee = new BubbleTee(position = posicionComida)
    unBubbleTee.esComidaPor(panda)
    assert.that(fondoNiveles.congelado())
  }
  test "Cuando se reiniciar descongela el fondo" {
    const unBubbleTee = new BubbleTee(position = posicionComida)
    unBubbleTee.esComidaPor(panda)
    fondoNiveles.reiniciar()
    assert.notThat(fondoNiveles.congelado())
  }
  test "Cambia de fondo cuando pasa de nivel" {
    panda.puntosSumados(10)
    controlDeNiveles.proximoNivel()
    assert.equals("fondo_nivel_2.png", fondoNiveles.image())
  }
}
describe "Cambios de Pantallas" {
  const posicionComida = game.at(2,0)
  test "Pantalla de Game Over cuando pierde todas las vidas" {
    const unAji = new Aji(position = posicionComida)
    unAji.esComidaPor(panda)
    const unHongo = new Hongo(position = posicionComida)
    unHongo.esComidaPor(panda)
    const otroAji = new Aji(position = posicionComida)
    otroAji.esComidaPor(panda)
    assert.equals(0, panda.vida())
    assert.that(game.hasVisual(fondoGameOver))
  }
  test "Pantalla de Game Over cuando desperdicia 5 comidas" {
    5.times({ i => new Bambu(position = game.at(1,0)).caer() }) // Iteración 
    assert.that(game.hasVisual(fondoGameOver))
  }
  test "Pantalla de victoria cuando gana" {
    panda.sumarPuntos(30)
    assert.equals(30, panda.puntosSumados())
    assert.that(game.hasVisual(fondoGanar))
  }
  test "Vuelve a inicio despues de perder y reinicia todo" {
    pandaSnack.finalizarSiPierde(panda)
    assert.that(game.hasVisual(fondoGameOver))

    pandaSnack.reiniciarJuego()
    assert.notThat(game.hasVisual(fondoGameOver))
    assert.equals(1, controlDeNiveles.nivelActual().numeroDeNivel())
    assert.equals(3, panda.vida())
    assert.equals(0, panda.puntosSumados())
  }
  test "Vuelve a inicio despues de ganar y reinicia todo" {
    controlDeNiveles.proximoNivel()
    pandaSnack.finalizarSiGana(panda)
    assert.that(game.hasVisual(fondoGanar))

    pandaSnack.reiniciarJuego()
    assert.notThat(game.hasVisual(fondoGanar))
    assert.equals(1, controlDeNiveles.nivelActual().numeroDeNivel())
    assert.equals(0, panda.puntosSumados())
  }
} 
describe "Movimientos Basicos" {
  test "En la esquina suroeste no puede moverse a la izquierda" {
  panda.position(game.at(0,0))
  assert.throwsException({ panda.mover(izquierda) })
}
test "En la esquina sudeste no puede moverse a la derecha" {
  panda.position(game.at(4,0))
  assert.throwsException({ panda.mover(derecha) })
}
test "Con efecto erratico, cerca del borde no puede moverse" {
  panda.position(game.at(3,0))
  const aji = new Aji(position = game.at(3,0))
  aji.esComidaPor(panda)
  assert.throwsException({ panda.mover(derecha) })
  assert.equals(game.at(3,0), panda.position())
}
} 
describe "Niveles"{
  test "Empieza en el nivel 1" {
    assert.equals(1, controlDeNiveles.nivelActual().numeroDeNivel())
  }
  test "Pasa al nivel 2 cuando se llega a 10 puntos" {
    panda.puntosSumados(10)
    controlDeNiveles.proximoNivel()
    assert.equals(2, controlDeNiveles.nivelActual().numeroDeNivel())
  }
  test "No pasa de nivel con menos puntos de los necesarios" {
    panda.puntosSumados(9)
    controlDeNiveles.proximoNivel()
    assert.equals(1, controlDeNiveles.nivelActual().numeroDeNivel())
  }
  test "Cuando se reiniciar vuelve al nivel 1" {
    panda.puntosSumados(100)
    controlDeNiveles.proximoNivel()
    controlDeNiveles.reiniciar()
    assert.equals(1, controlDeNiveles.nivelActual().numeroDeNivel())
  }
  test "La comida cae mas rapido en cada nivel" {
    assert.equals(1800, controlDeNiveles.ticksDeNivel())
    nivel.siguiente()
    assert.equals(1300, controlDeNiveles.ticksDeNivel())
    nivel.siguiente()
    assert.equals(800, controlDeNiveles.ticksDeNivel())
  }
  test "Los puntos para subir son 10, 20 y 30" {
    assert.equals(10, nivel.puntosParaSubir())
    nivel.siguiente()
    assert.equals(20, nivel.puntosParaSubir())
    nivel.siguiente()
    assert.equals(30, nivel.puntosParaSubir())
  }
  test "El nivel 3 es el ultimo" {
    assert.notThat(nivel.esUltimo())
    nivel.siguiente()
    assert.notThat(nivel.esUltimo())
    nivel.siguiente()
    assert.that(nivel.esUltimo())
  }

}
describe "Fabrica de comida" {
  const posicion = game.at(2,6)

  test "Probabilidad baja de una comida" {
    assert.equals("Comida_bambú.png", fabricaDeComida.determinarTipoDeComida(1, posicion).image())
  }
  test "Probabilidad media  de una comida" {
    assert.equals("Comida_aji.png", fabricaDeComida.determinarTipoDeComida(80, posicion).image())
  }
  test "Probabilidad alta de una comida" {
    assert.equals("Comida_hongo.png", fabricaDeComida.determinarTipoDeComida(100, posicion).image())
  }
}
describe "Contadores en pantalla" {
  test "El contador de vidas muestra las vidas actuales" {
    assert.equals("contador_vida_3.png", contadorDeVidas.image())
    panda.perderVida()
    assert.equals("contador_vida_2.png", contadorDeVidas.image())
  }
  test "El contador de puntos muestra los puntos actuales" {
    assert.equals("contador_0.png", contadorDepuntos.image())
    panda.sumarPuntos(5)
    assert.equals("contador_5.png", contadorDepuntos.image())
  }
  test "El contador de comidas desperdiciadas muestra las actuales" {
    assert.equals("contador_comidas_desperdiciadas_0.png", contadorDeComidasDesperdiciadas.image())
    panda.sumaDeComidasDesperdiciadas()
    assert.equals("contador_comidas_desperdiciadas_1.png", contadorDeComidasDesperdiciadas.image())
  }
}
describe "Selector de personaje" {
  test "Elije al Panda masculino para jugar" {
    selectorPersonaje.elegirMasculino()
    assert.equals(pandaHombre, selectorPersonaje.personajeElegido())
    assert.equals(game.at(1,3), selectorPersonaje.position())
  }
  test "Elije al Panda femenino para jugar" {
    selectorPersonaje.elegirFemenino()
    assert.equals(pandaMujer, selectorPersonaje.personajeElegido())
    assert.equals(game.at(3,3), selectorPersonaje.position())
  }
}
describe "Sistema de sonido"{
  test"Se puede subir el volumen"{
    musica.subirVolumen()
    assert.equals(0.6, musica.volumen())
  }
  test"Se puede bajar el volumen"{
    musica.bajarVolumen()
    assert.equals(0.4, musica.volumen())
  }
  test "Se puede silenciar la musica" {
    musica.alternarSilencio()
    assert.that(musica.silenciada())
    assert.equals(0, musica.volumenReal())
  }
  test "Silenciar dos veces vuelve a activar el sonido con el mismo valor de volumen" {
    musica.alternarSilencio()
    musica.alternarSilencio()
    assert.notThat(musica.silenciada())
    assert.equals(0.5, musica.volumenReal())
  }
  test "Cambiar el volumen estando silenciada no hace sonar la musica" {
    musica.alternarSilencio()
    musica.bajarVolumen()
    assert.that(musica.silenciada())
    assert.equals(0, musica.volumenReal())
  }

}